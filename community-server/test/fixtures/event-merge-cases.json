{
  "about": "Shared table for the guild-event merge rule. Each case is run against eventDecision() of the server (lib/guilds.js) and, when the addon file and a Lua runner are present, against BackstageForeverEventMerge of the addon. old: the stored event or null; incoming: the event that arrives; direct: it comes from its own author (editor, else creator); accept: whether it replaces what is stored.",
  "cases": [
    { "name": "an unknown event from its creator is taken", "old": null, "incoming": { "version": 1, "creator": "Anna", "editor": null }, "direct": true, "accept": true },
    { "name": "an unknown event passed on by somebody else is taken", "old": null, "incoming": { "version": 3, "creator": "Anna", "editor": null }, "direct": false, "accept": true },
    { "name": "a higher version from the author wins", "old": { "version": 2, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 3, "creator": "Anna", "editor": null }, "direct": true, "accept": true },
    { "name": "a lower version from the author loses", "old": { "version": 3, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 2, "creator": "Anna", "editor": null }, "direct": true, "accept": false },
    { "name": "the same version from the same author changes nothing", "old": { "version": 3, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 3, "creator": "Anna", "editor": null }, "direct": true, "accept": false },
    { "name": "tie: the later editor name wins", "old": { "version": 4, "creator": "Anna", "editor": "Bob", "relayed": false }, "incoming": { "version": 4, "creator": "Anna", "editor": "Zoe" }, "direct": true, "accept": true },
    { "name": "tie: the earlier editor name loses", "old": { "version": 4, "creator": "Anna", "editor": "Bob", "relayed": false }, "incoming": { "version": 4, "creator": "Anna", "editor": "Abe" }, "direct": true, "accept": false },
    { "name": "tie: an editor against the creator's own version, editor later in the alphabet", "old": { "version": 2, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 2, "creator": "Anna", "editor": "Bob" }, "direct": true, "accept": true },
    { "name": "tie: the creator against an editor later in the alphabet", "old": { "version": 2, "creator": "Anna", "editor": "Bob", "relayed": false }, "incoming": { "version": 2, "creator": "Anna", "editor": null }, "direct": true, "accept": false },
    { "name": "tie: the creator later in the alphabet than the editor", "old": { "version": 2, "creator": "Milo", "editor": "Bob", "relayed": false }, "incoming": { "version": 2, "creator": "Milo", "editor": null }, "direct": true, "accept": true },
    { "name": "tie: names that differ only in upper and lower case are the same name", "old": { "version": 5, "creator": "Anna", "editor": "bob", "relayed": false }, "incoming": { "version": 5, "creator": "Anna", "editor": "BOB" }, "direct": true, "accept": false },
    { "name": "tie: case is folded before comparing (Zed is after abe)", "old": { "version": 5, "creator": "Anna", "editor": "abe", "relayed": false }, "incoming": { "version": 5, "creator": "Anna", "editor": "Zed" }, "direct": true, "accept": true },
    { "name": "tie: case is folded before comparing (abe is before Zed)", "old": { "version": 5, "creator": "Anna", "editor": "Zed", "relayed": false }, "incoming": { "version": 5, "creator": "Anna", "editor": "abe" }, "direct": true, "accept": false },
    { "name": "tie: a longer name that starts the same is later", "old": { "version": 5, "creator": "Anna", "editor": "Bob", "relayed": false }, "incoming": { "version": 5, "creator": "Anna", "editor": "Bobby" }, "direct": true, "accept": true },
    { "name": "tie: an editor field naming the creator is the creator", "old": { "version": 2, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 2, "creator": "Anna", "editor": "Anna" }, "direct": true, "accept": false },
    { "name": "tie: a name with an accented first letter sorts after plain letters", "old": { "version": 5, "creator": "Anna", "editor": "Zed", "relayed": false }, "incoming": { "version": 5, "creator": "Anna", "editor": "Émile" }, "direct": true, "accept": true },
    { "name": "the author replaces a passed-on copy, even with a lower version", "old": { "version": 6, "creator": "Anna", "editor": null, "relayed": true }, "incoming": { "version": 2, "creator": "Anna", "editor": null }, "direct": true, "accept": true },
    { "name": "the author replaces a passed-on copy of the same version", "old": { "version": 6, "creator": "Anna", "editor": null, "relayed": true }, "incoming": { "version": 6, "creator": "Anna", "editor": null }, "direct": true, "accept": true },
    { "name": "a passed-on copy never replaces what the author said, even with a higher version", "old": { "version": 2, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 9, "creator": "Anna", "editor": null }, "direct": false, "accept": false },
    { "name": "a newer passed-on copy replaces an older passed-on copy", "old": { "version": 2, "creator": "Anna", "editor": null, "relayed": true }, "incoming": { "version": 3, "creator": "Anna", "editor": null }, "direct": false, "accept": true },
    { "name": "a passed-on copy of the same version changes nothing", "old": { "version": 3, "creator": "Anna", "editor": null, "relayed": true }, "incoming": { "version": 3, "creator": "Anna", "editor": null }, "direct": false, "accept": false },
    { "name": "an older passed-on copy changes nothing", "old": { "version": 3, "creator": "Anna", "editor": null, "relayed": true }, "incoming": { "version": 2, "creator": "Anna", "editor": null }, "direct": false, "accept": false },
    { "name": "a passed-on copy with an editor follows the same rule", "old": { "version": 3, "creator": "Anna", "editor": null, "relayed": true }, "incoming": { "version": 4, "creator": "Anna", "editor": "Bob" }, "direct": false, "accept": true },
    { "name": "an event id that belongs to another creator is refused", "old": { "version": 1, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 9, "creator": "Cara", "editor": null }, "direct": true, "accept": false },
    { "name": "another creator is refused even against a passed-on copy", "old": { "version": 1, "creator": "Anna", "editor": null, "relayed": true }, "incoming": { "version": 9, "creator": "Cara", "editor": null }, "direct": true, "accept": false },
    { "name": "the creator's name in other letter case is the same creator", "old": { "version": 1, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 2, "creator": "ANNA", "editor": null }, "direct": true, "accept": true },
    { "name": "an editor's higher version wins over the creator's", "old": { "version": 2, "creator": "Anna", "editor": null, "relayed": false }, "incoming": { "version": 3, "creator": "Anna", "editor": "Abe" }, "direct": true, "accept": true },
    { "name": "the creator's higher version wins over an editor's", "old": { "version": 3, "creator": "Anna", "editor": "Zoe", "relayed": false }, "incoming": { "version": 4, "creator": "Anna", "editor": null }, "direct": true, "accept": true }
  ]
}
