{
  "name": "backstage-forever",
  "productName": "Backstage Forever",
  "version": "0.12.3",
  "releaseChannel": "preview",
  "description": "A local-first adventure companion from Backstage Coding. Designed by Frank Arena.",
  "author": "Frank Arena / Backstage Coding",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farena-ai/Backstage-Forever.git"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:ui": "node scripts/smoke.cjs",
    "test:setup": "node scripts/setup-smoke.cjs",
    "test:autosave": "node scripts/autosave-smoke.cjs",
    "test:integration": "node scripts/integration.cjs",
    "test:packaged": "node scripts/packaged-smoke.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "test:command-center": "node scripts/command-center-smoke.cjs",
    "test:knowledge": "node scripts/knowledge-smoke.cjs",
    "build:addon-reference": "node scripts/build-addon-reference.cjs",
    "check:addon-reference": "node scripts/build-addon-reference.cjs --check",
    "test:living-backend": "node scripts/living-backend-smoke.cjs",
    "test:living-setup": "node scripts/living-setup-smoke.cjs",
    "test:company-backend": "node scripts/company-backend-smoke.cjs",
    "test:company": "node scripts/company-smoke.cjs --setup-races",
    "test:director-backend": "node scripts/director-backend-smoke.cjs",
    "test:director": "node scripts/director-smoke.cjs",
    "test:preparation-backend": "node scripts/preparation-backend-smoke.cjs",
    "test:preparation": "node scripts/preparation-smoke.cjs",
    "test:memory-backend": "node scripts/memory-backend-smoke.cjs",
    "test:voice-backend": "node scripts/voice-backend-smoke.cjs",
    "test:voice-memory": "node scripts/voice-memory-smoke.cjs",
    "test:travel-companion": "node --test --test-concurrency=1 tests/travel-companion.test.cjs tests/companion-reply.test.cjs && node scripts/travel-companion-smoke.cjs",
    "test:conversation": "node scripts/conversation-smoke.cjs",
    "test:companion-recovery": "node scripts/companion-recovery-smoke.cjs",
    "test:product-polish": "node scripts/product-polish-smoke.cjs",
    "test:support": "node scripts/support-smoke.cjs",
    "test:recovery": "node scripts/recovery-smoke.cjs",
    "test:party-backend": "node scripts/party-backend-smoke.cjs",
    "test:party": "node scripts/party-smoke.cjs",
    "check:forever-vendors": "node scripts/build-forever-vendors.cjs --check",
    "check:forever-insights": "node scripts/build-forever-insights.cjs --check",
    "check:forever-travel": "node scripts/build-forever-travel.cjs --check",
    "test:travel": "node --test --test-concurrency=1 tests/travel-data.test.cjs tests/travel.test.cjs",
    "test:insights": "node scripts/insights-smoke.cjs",
    "test:character-guidance": "node scripts/character-guidance-smoke.cjs",
    "test:player-shell": "node scripts/player-shell-smoke.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "fengari-node-cli": "0.1.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "com.backstagecoding.backstageforever",
    "productName": "Backstage Forever",
    "artifactName": "Backstage-Forever-${version}-Windows-${arch}-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "data/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "docs/*.md",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "addon",
        "to": "addon",
        "filter": [
          "**/*.toc",
          "**/*.lua",
          "**/README.md"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@anthropic-ai/sdk": "1.6.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.16",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
